<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/nav_home">

    <fragment
        android:id="@+id/nav_home"
        android:name="com.example.tuprak40.fragment.HomeFragment"
        android:label="Home">
        <action
            android:id="@+id/action_home_to_add"
            app:destination="@id/nav_add" />
    </fragment>

    <fragment
        android:id="@+id/nav_favorites"
        android:name="com.example.tuprak40.fragment.FavoritesFragment"
        android:label="Favorites">
        <action
            android:id="@+id/action_favorites_to_add"
            app:destination="@id/nav_add" />
    </fragment>

    <fragment
        android:id="@+id/nav_add"
        android:name="com.example.tuprak40.fragment.AddBookFragment"
        android:label="Add Book" />

</navigation>