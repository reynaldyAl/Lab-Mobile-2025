<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="SearchViewStyle" parent="Widget.AppCompat.SearchView">
        <item name="android:textColorHint">#80FFFFFF</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:tint">#FFFFFF</item>
        <item name="android:colorControlNormal">#FFFFFF</item>
        <!-- Primary color of your app -->
        <item name="colorPrimary">#4CAF50</item>
        <item name="colorPrimaryVariant">#3B8E3F</item>
        <item name="colorOnPrimary">#FFFFFF</item>

        <!-- Secondary colors -->
        <item name="colorSecondary">#E91E63</item>
        <item name="colorSecondaryVariant">#C2185B</item>
        <item name="colorOnSecondary">#FFFFFF</item>

        <!-- Background colors -->
        <item name="android:colorBackground">#191919</item>
        <item name="colorSurface">#292a2d</item>
        <item name="colorOnSurface">#FFFFFF</item>

        <!-- Status bar and nav bar color -->
        <item name="android:statusBarColor">#000000</item>
        <item name="android:navigationBarColor">#000000</item>

        <!-- Prevent fullscreen keyboard issue -->
        <item name="android:windowTranslucentStatus">false</item>
        <item name="android:windowTranslucentNavigation">false</item>



    </style>

    <style name="TextAppearance.ExpandedTitle" parent="TextAppearance.AppCompat.Title">
        <item name="android:textSize">28sp</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:shadowColor">#80000000</item>
        <item name="android:shadowDx">0</item>
        <item name="android:shadowDy">2</item>
        <item name="android:shadowRadius">6</item>
    </style>



</resources>